const ACTION_KW := [
	["quick", ["بازی سریع پیدا", "حریف پیدا", "پیدا کن بازی", "find match", "play now", "یه بازی"]],
	["claim", ["جایزه هام", "جایزه ها", "بگیر", "claim", "دریافت جایزه"]],
	["disc", ["پیشنهاد دیسک", "چه دیسکی", "دیسک بخرم", "recommend"]],
	["stats", ["آمار من", "آمارم", "my stats", "وضعیتم", "پیشرفتم"]],
	["shop", ["فروشگاه", "shop", "store"]],
	["clubs", ["کلاب ها", "باشگاه ها"]],
]

static var _rx_harakat: RegEx = null
static var _rx_other: RegEx = null
static var _rx_space: RegEx = null


static func normalize(text: String) -> String:
	if _rx_harakat == null:
		_rx_harakat = RegEx.create_from_string("[\\x{064B}-\\x{0652}\\x{0640}]")
		_rx_other = RegEx.create_from_string("[^a-z0-9\\x{0600}-\\x{06FF}\\s]")
		_rx_space = RegEx.create_from_string("\\s+")
	var t := text.to_lower()
	var out := ""
	for ch in t:
		match ch:
			"ي", "ى": out += "ی"
			"ك": out += "ک"
			"ة", "ۀ": out += "ه"
			"أ", "إ", "آ": out += "ا"
			"ؤ": out += "و"
			"\u200c": out += " "
			_:
				var c := ch.unicode_at(0)
				if c >= 0x06F0 and c <= 0x06F9:
					out += char(48 + c - 0x06F0)
				elif c >= 0x0660 and c <= 0x0669:
					out += char(48 + c - 0x0660)
				else:
					out += ch
	out = _rx_harakat.sub(out, "", true)
	out = _rx_other.sub(out, " ", true)
	out = _rx_space.sub(out, " ", true)
	return out.strip_edges()


## -> {intent: Dictionary or null, action: String ("" = none)}
static func match_intent(text: String) -> Dictionary:
	var q := " " + normalize(text) + " "
	if q.strip_edges() == "":
		return {"intent": null, "action": ""}
	for pair in ACTION_KW:
		for k in pair[1]:
			if q.contains(normalize(k)):
				return {"intent": null, "action": pair[0]}
	var best: Variant = null
	var score := 0.0
	for it in INTENTS:
		var sc := 0.0
		for k in it["kw"]:
			var n := normalize(k)
			if n != "" and q.contains(n):
				sc += 1.0 + n.length() / 6.0
		if sc > score:
			score = sc
			best = it
	return {"intent": best if score >= 1.0 else null, "action": ""}
