; Engine configuration file.
config_version=5

[application]
config/name="NEXORA"
config/version="2.0.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://assets/icon.png"
boot_splash/bg_color=Color(0.016, 0.02, 0.06, 1)
boot_splash/image="res://assets/splash-icon.png"
run/max_fps=0
run/low_processor_mode=false

[autoload]
Data="*res://src/core/data.gd"
Store="*res://src/core/store.gd"
Sfx="*res://src/core/sfx.gd"
Supa="*res://src/net/supa.gd"
Voice="*res://src/net/voice.gd"
Nav="*res://src/core/nav.gd"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=432
window/size/window_height_override=936
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[internationalization]

rendering/root_node_layout_direction=1
locale/fallback="fa"

[input_devices]
pointing/emulate_touch_from_mouse=true

[gui]
theme/custom="res://src/ui/theme.tres"
common/snap_controls_to_pixels=true

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=false
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.016, 0.02, 0.06, 1)

[editor_plugins]

enabled=PackedStringArray("res://addons/nexora_livekit/plugin.cfg")
